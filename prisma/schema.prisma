generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalogue / inventory
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id         String   @id @default(cuid())
  name       String
  sku        String   @unique
  price      Decimal  @db.Decimal(14, 2)
  cost       Decimal  @db.Decimal(14, 2)
  stockQty   Int      @default(0)
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Parties
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([name])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ---------------------------------------------------------------------------
// Sales, payments and stock ledger
// ---------------------------------------------------------------------------

enum SaleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  OTHER
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model Sale {
  id          String     @id @default(cuid())
  invoiceNo   String     @unique
  customerId  String
  totalAmount Decimal    @db.Decimal(14, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(14, 2)
  status      SaleStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(14, 2)
  lineTotal Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([paidAt])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  type        InventoryMovementType
  // Signed quantity: positive increases stock, negative decreases stock.
  quantity    Int
  referenceId String?
  createdAt   DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([referenceId])
}

// Transactional day-based invoice number allocation. The sale service updates
// this row inside the same transaction that creates the sale.
model InvoiceSequence {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}
