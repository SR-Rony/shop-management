# Copy to .env.local for local development. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_management_erp?schema=public"
# Neon only: use the direct (non-pooled) connection for Prisma CLI migrations.
# This is usually DATABASE_URL with "-pooler" removed from the hostname.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST_WITHOUT_POOLER:5432/shop_management_erp?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
DEFAULT_CURRENCY="BDT"
DEFAULT_TIMEZONE="Asia/Dhaka"
